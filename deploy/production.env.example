# DevPath production settings.
# Copy this file to deploy/production.env (git-ignored) and fill it in. Never commit the filled-in file.
# deploy/publish.ps1 checks these values, writes the app settings into the published web.config as
# environment variables (IIS never serves web.config), and uses the DEPLOY_* values for Web Deploy.
# Names use ASP.NET Core's convention: a double underscore (__) separates configuration sections.

# ---------- App settings (secrets) ----------

# Public address of the site, used in email links. Must be https.
Frontend__BaseUrl=https://your-site.runasp.net

# SQL Server connection string from the MonsterASP.NET control panel (Databases -> MSSQL).
ConnectionStrings__DevPath=Server=db12345.public.databaseasp.net;Database=db12345;User Id=db12345;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False

# Transactional email through Brevo (free tier: about 300 emails a day). See docs/EMAIL.md.
Email__Provider=Brevo
Email__SenderEmail=no-reply@your-verified-domain.com
Email__SenderName=DevPath
Email__Brevo__ApiKey=xkeysib-CHANGE_ME

# Main administrator. The address is also in appsettings.json; set it here to override.
Admin__OwnerEmail=muhammadssaeed0@gmail.com
# Optional: creates the main administrator account with this password on first start, if no account
# uses the address yet. Leave empty to register normally and take the account over with "Forgot password".
# Use a long random password and change it after the first sign-in.
Admin__OwnerPassword=

# ---------- Web Deploy (used by publish.ps1 -Deploy; never written to the site) ----------
# From the MonsterASP.NET control panel: Websites -> your site -> Deploy -> WebDeploy.
DEPLOY_SITE=site12345
DEPLOY_SERVER=site12345.siteasp.net
DEPLOY_USERNAME=site12345
DEPLOY_PASSWORD=CHANGE_ME
