{
  "//": "Production defaults. No secrets here: the connection string, Brevo API key, sender, site URL and owner password come from environment variables (see deploy/production.env.example and docs/DEPLOYMENT.md).",
  "ConnectionStrings": {
    "DevPath": ""
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Email": {
    "Provider": "Brevo",
    "SenderName": "DevPath"
  },
  "Auth": {
    "AttemptsPerMinute": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "DevPath": "Information",
      "DatabaseInitializer": "Information"
    }
  }
}
