      "expected": {
        "columns": [
          "name",
          "tbl_name"
        ],
        "rows": [
          [
            "IX_Orders_Customer_Date",
            "Orders"
          ]
        ]
      }
    },
    {
      "nameEn": "Its columns are CustomerId, then OrderDate",
      "nameAr": "أعمدته CustomerId ثم OrderDate",
      "sql": "SELECT name FROM pragma_index_info('IX_Orders_Customer_Date') ORDER BY seqno",
      "ordered": true,
      "expected": {
        "columns": [
          "name"
        ],
        "rows": [
          [
            "CustomerId"
          ],
          [
            "OrderDate"
          ]
        ]
      }
    }
  ]
