<!-- res/xml/network_security_config.xml, referenced from the manifest's <application> -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config>
        <domain includeSubdomains="true">api.bank.example</domain>
        <pin-set expiration="2027-12-31">
            <pin digest="SHA-256">7HIpactkIAq2Y49orFOOQKurWxmmSFZhBCoQYcRhJ3Y=</pin>  <!-- current key -->
            <pin digest="SHA-256">fwza0LRMXouZHRC8Ei+4PyuldPDcf3UKgO/04cDM1oE=</pin>  <!-- backup key -->
        </pin-set>
    </domain-config>

    <!-- Only in debug builds: trust user-added CAs such as mitmproxy -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
