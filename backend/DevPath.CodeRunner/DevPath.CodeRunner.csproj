<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The C# runner for the Practice Lab and Code Playground. It runs entirely in the learner's
    browser: Roslyn compiles the code to an in-memory assembly and the .NET WebAssembly runtime
    executes it inside a Web Worker in a sandboxed iframe, so learner code never runs on the server.
    Published into frontend/public/runners/csharp by scripts/build-runners.ps1.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Learner code may call any part of the base class library, so nothing is trimmed away. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Real exception messages ("Index was outside the bounds of the array.") instead of resource keys. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- Browser-only APIs are expected here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <!--
    Learner code is compiled against the reference assemblies of this .NET version. They are copied
    next to the runtime (refs/) together with a manifest listing them.
  -->
  <ItemGroup>
    <RunnerReference Include="System.Runtime;System.Console;System.Collections;System.Collections.Concurrent;System.Collections.Immutable;System.Linq;System.Linq.Expressions;System.Text.RegularExpressions;System.Threading;System.Threading.Tasks;System.Runtime.Extensions;System.ComponentModel.Annotations;System.ComponentModel.Primitives;System.ComponentModel;System.ObjectModel;System.Text.Json;System.Memory;System.Runtime.Numerics;System.Text.Encoding.Extensions;System.Diagnostics.Debug;netstandard" />
  </ItemGroup>

  <Target Name="CopyRunnerReferences" AfterTargets="Publish">
    <PropertyGroup>
      <RefPackDir>$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref\$(BundledNETCoreAppPackageVersion)\ref\$(TargetFramework)</RefPackDir>
      <RefOutDir>$(PublishDir)wwwroot\refs</RefOutDir>
      <RefList>@(RunnerReference, '","')</RefList>
    </PropertyGroup>
    <Error Condition="!Exists('$(RefPackDir)\System.Runtime.dll')" Text="Reference assemblies not found in $(RefPackDir)." />
    <Copy SourceFiles="@(RunnerReference->'$(RefPackDir)\%(Identity).dll')" DestinationFolder="$(RefOutDir)" />
    <WriteLinesToFile File="$(RefOutDir)\manifest.json" Lines="[&quot;$(RefList)&quot;]" Overwrite="true" />
  </Target>

</Project>
